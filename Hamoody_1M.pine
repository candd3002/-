// This source code is subject to the terms of the Mozilla Public License 2.0
//@version=5

// =============================================================================
// Congestion Breakout Pro
//
// Detects sideways/ranging congestion zones and trades their breakout, using
// Heikin Ashi candle shape (optional) to judge trend character while always
// anchoring zone boundaries, breakout confirmation, and risk levels to real
// price. Designed and validated for the M15 timeframe.
//
// Zone detection is dynamic / variable-width: on any bar whose candle is
// "decisive" (engulfing, or an oversized body vs. recent average), the script
// scans backward bar-by-bar to see how far a genuinely sideways run extends
// behind it. The zone's width is whatever that scan naturally finds -- no
// fixed lookback. If the scan is still sideways when it hits the maximum
// bar cap (i.e. it never naturally resolved), the zone is rejected outright
// as too large/messy to trust, rather than accepted at the max size. This
// keeps sprawling, unclear consolidations from getting boxed while still
// catching short (2-3 candle) genuine zones.
//
// Repainting safety notes (read before modifying):
//   - No request.security() is used, so there is no cross-timeframe lookahead
//     risk. Apply this script directly to the timeframe you want to trade.
//   - The backward-growth scan and the breakout candle are only ever
//     evaluated using the CURRENT bar's own close, which is the normal,
//     expected way any real-time indicator works: the plotted state finalizes
//     the instant the bar closes and is never retroactively altered afterward.
//   - Boxes are drawn once, fully-formed, at the signal bar -- using only
//     already-closed historical bars. They are never rewritten afterward.
//
// ENGINE ADDED (Liquidity Sweep + Trend Engine):
//   Swing highs/lows -> structure trend (HH/HL, LH/LL, range) -> liquidity
//   sweep vs. real break classification -> structure-shift confirmation ->
//   BUY/SELL decision with a locked 1:R reward:risk. Turn the engine OFF in
//   the inputs and the indicator behaves exactly as it did before.
// =============================================================================

indicator("Hamoody 1M", shorttitle = "Hamoody 1M", overlay = true,
     max_boxes_count = 300, max_labels_count = 300, max_lines_count = 300)

// =============================================================================
// INPUTS
// =============================================================================

grp_zone = "Congestion Detection"
i_useHA = input.bool(true, "Use Heikin Ashi for pattern shape", group = grp_zone,
     tooltip = "Heikin Ashi values are used only to judge candle shape (engulfing, body size, sideways character). Zone boundaries, breakout confirmation, and SL/TP always use real price, since HA values aren't directly tradeable.")
i_plotHA = input.bool(false, "Also plot Heikin Ashi candles", group = grp_zone,
     tooltip = "Overlays HA candles on the chart. For a clean view, set your chart's candle style to hidden/line when this is on, since the real candles remain underneath.")
i_zoneLen = input.int(30, "Zone Length (bars)", minval = 5, maxval = 100, group = grp_zone,
     tooltip = "Fixed lookback window tested every bar for sideways/ranging shape. A variable-width backward-growth version was tried and tested worse (lower profit factor, far fewer valid signals) despite fixing legitimate zone-width variability -- this fixed window is the mechanism that produced the best validated backtest result so far.")
i_maxTrendRatio = input.float(0.4, "Max Trend Ratio", minval = 0.05, maxval = 1.0, step = 0.05, group = grp_zone,
     tooltip = "Net directional move across the zone window, divided by its range. Lower = stricter sideways requirement. This is a SHAPE filter, not a width filter.")
i_maxSwingATR = input.float(5.0, "Max Zone Swing (x ATR)", minval = 0.5, step = 0.5, group = grp_zone,
     tooltip = "The trend-ratio test only compares the window's two ENDPOINTS, so a window can contain a real large swing (high near one edge, low near the other) and still read as 'sideways' if price round-trips back near its starting point by the end. This is a second, independent check on the window's actual high-to-low range (in ATR multiples) to catch that case. Calibrated empirically: trades whose zone exceeded 5x ATR were disproportionately losers (5 of 6 in backtest, net -$213.72) vs. the rest of the trade population.")
i_avgBodyLen = input.int(20, "Average Body Lookback (bars)", minval = 5, maxval = 100, group = grp_zone,
     tooltip = "Fixed lookback used only to measure typical candle body size, for the big-body breakout test. Independent of the dynamic zone size.")
i_minMoveATR = input.float(1.0, "Min Move to Allow New Zone (x ATR)", minval = 0.1, step = 0.1, group = grp_zone,
     tooltip = "After a signal fires, a new zone/signal that substantially overlaps it in price is suppressed until EITHER price moves at least this many ATRs beyond it, OR enough new bars pass (see Dedup Cooldown) -- whichever happens first.")
i_dedupCooldownBars = input.int(10, "Dedup Cooldown (bars)", minval = 1, maxval = 100, group = grp_zone,
     tooltip = "Minimum bars since the last signal before a new zone/signal is allowed. Combined with the ATR-distance check (Min Move to Allow New Zone) -- BOTH must be satisfied, not just one. An OR here let the strategy re-fire into the same failed move almost immediately after a stop-out, since price often clears the ATR distance within 1-2 bars on its own.")

grp_trend = "Trend Context (tag only)"
i_trendEmaLen = input.int(50, "Trend EMA Length", minval = 1, group = grp_trend,
     tooltip = "Separate from any EMA(200) trend filter used elsewhere (e.g. InpTrendLen in the MT5 version, which serves a different purpose). This EMA only TAGS a signal as counter-trend or aligned -- it never blocks or resizes a trade.")

grp_breakout = "Breakout"
i_bodyMult = input.float(1.5, "Breakout Body Multiplier", minval = 1.0, step = 0.1, group = grp_breakout,
     tooltip = "A non-engulfing breakout candle must have a body at least this many times the average candle body (see Average Body Lookback) to qualify.")

grp_digital = "Digital Level Confluence"
i_showDigital = input.bool(true, "Highlight round-number confluence", group = grp_digital,
     tooltip = "Purely visual: marks signals that occur near a round price level.")
i_requireDigital = input.bool(false, "Require round-number confluence to signal", group = grp_digital,
     tooltip = "When on, a signal only fires if it's also near a round level -- turns the highlight into a hard filter.")
i_digitalStep = input.float(10.0, "Round Number Spacing", minval = 0.1, group = grp_digital,
     tooltip = "E.g. 10 for gold checks proximity to every $10 level (4100, 4110, 4120...).")
i_digitalTolATR = input.float(0.5, "Proximity Tolerance (x ATR)", minval = 0.05, step = 0.05, group = grp_digital)

grp_risk = "Risk Management"
i_atrLen = input.int(14, "ATR Length", minval = 1, group = grp_risk)
i_slBufferATR = input.float(0.1, "SL Buffer (x ATR)", minval = 0.0, step = 0.05, group = grp_risk,
     tooltip = "Extra distance beyond the zone's extreme, so normal noise doesn't stop you out right at the liquidity point.")
i_slRangeMult = input.float(1.75, "SL Distance (x Zone Range)", minval = 0.5, maxval = 5.0, step = 0.25, group = grp_risk,
     tooltip = "Stop-loss distance is this many multiples of the ZONE'S OWN high-low range, not a flat ATR number -- scales per-trade with how wide or tight the detected zone actually is. Calibrated so the typical resulting SL lands around the ~5-6x ATR ballpark that the original fixed 30-bar-zone version implicitly used (measured empirically), where a profitable PF was previously observed. Replaces a flat ATR floor, which decoupled SL from the trade's own structure. (Used when the Engine is OFF.)")
i_tpMethod = input.string("Fixed R:R", "Take Profit Method", options = ["Fixed R:R", "Next Round Level"], group = grp_risk,
     tooltip = "Used when the Engine is OFF. With the Engine ON, TP is always entry +/- risk x Engine R:R.")
i_fixedRR = input.float(0.5, "Fixed Risk:Reward Ratio", minval = 0.1, step = 0.1, group = grp_risk,
     tooltip = "Used when the Engine is OFF. With the Engine ON, the locked Engine R:R below is used instead.")

grp_visual = "Visuals"
i_boxFill = input.color(color.new(#5B7FA6, 88), "Zone Fill", group = grp_visual)
i_boxBorder = input.color(color.new(#5B7FA6, 40), "Zone Border", group = grp_visual)
i_buyColor = input.color(#1E9E7A, "Buy Color", group = grp_visual)
i_sellColor = input.color(#D94F4F, "Sell Color", group = grp_visual)
i_labelSize = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal"], group = grp_visual)
i_showRR = input.bool(true, "Show R:R Label", group = grp_visual)

// ---- Engine inputs (NEW) -----------------------------------------------------

grp_engS = "Engine - Structure & Trend"
i_useEngine = input.bool(true, "Enable Liquidity Sweep + Trend Engine", group = grp_engS,
     tooltip = "ON: signals come from (a) congestion breakouts that pass the trend/structure and candle-quality checks, and (b) liquidity-sweep reversals confirmed by a structure shift -- all with a locked R:R and structure-based SL. OFF: the indicator behaves exactly as before.")
i_swingLen = input.int(5, "Swing Length (bars each side)", minval = 2, maxval = 30, group = grp_engS,
     tooltip = "A swing high/low is confirmed this many bars after it forms (no repainting). Larger = fewer, more significant tops/bottoms.")
i_trendSlowLen = input.int(200, "Slow EMA (bias)", minval = 10, group = grp_engS,
     tooltip = "Used only as one point in the sweep quality score (price on the right side of the slow EMA). The trend itself comes from market structure.")
i_trendGate = input.bool(true, "Trade only with structure trend", group = grp_engS,
     tooltip = "Uptrend (HH+HL) = buys only. Downtrend (LH+LL) = sells only. Counter-trend setups are blocked. In RANGE both sides are allowed if the next option is on.")
i_allowRange = input.bool(true, "Allow trades when structure is RANGE", group = grp_engS)

grp_engQ = "Engine - Sweep vs Real Break"
i_reclaimBars = input.int(3, "Max bars to close back inside (else REAL break)", minval = 1, maxval = 20, group = grp_engQ,
     tooltip = "After price pushes past a swing high/low: if it CLOSES back inside within this many bars it was a liquidity sweep (false break). If it stays outside, it is a real break and the level is retired.")
i_minDepthATR = input.float(0.05, "Min sweep depth (x ATR)", minval = 0.0, step = 0.05, group = grp_engQ,
     tooltip = "Ignores micro-pokes beyond the level.")
i_maxDepthATR = input.float(2.0, "Max sweep depth (x ATR)", minval = 0.2, step = 0.1, group = grp_engQ,
     tooltip = "A push deeper than this is treated as a real break, not a sweep.")
i_wickPct = input.float(0.4, "Min rejection wick (share of candle range)", minval = 0.0, maxval = 1.0, step = 0.05, group = grp_engQ)
i_volMult = input.float(1.2, "Volume spike (x 20-bar average)", minval = 0.5, step = 0.1, group = grp_engQ,
     tooltip = "Optional quality point. Ignored automatically if the symbol has no volume data.")
i_eqTolATR = input.float(0.25, "Equal highs/lows tolerance (x ATR)", minval = 0.0, step = 0.05, group = grp_engQ,
     tooltip = "Two swing lows (or highs) this close count as 'equal' = a cluster of resting stops, a richer liquidity pool.")
i_dispATR = input.float(0.8, "Displacement body (x ATR)", minval = 0.1, step = 0.1, group = grp_engQ,
     tooltip = "A confirmation/breakout candle with a body this large counts as displacement (real intent, not drift).")
i_chochLen = input.int(6, "Structure-shift lookback (bars)", minval = 2, maxval = 30, group = grp_engQ,
     tooltip = "After a sweep, the BUY/SELL is only confirmed when price CLOSES through the highest high (bull) or lowest low (bear) of this many bars before the sweep. No entry ever happens on the sweep candle itself.")
i_armBars = input.int(15, "Bars to wait for the structure shift", minval = 1, maxval = 100, group = grp_engQ)
i_minScore = input.int(3, "Min quality score (0-7) to allow a sweep trade", minval = 0, maxval = 7, group = grp_engQ,
     tooltip = "Points: same-candle reclaim, rejection wick, volume spike, equal highs/lows, slow-EMA side, discount/premium location, displacement at confirmation. Tune per symbol/timeframe by backtest -- these defaults are hypotheses, not proven values.")
i_maxBrkWick = input.float(0.4, "Max rejection wick on a breakout candle", minval = 0.0, maxval = 1.0, step = 0.05, group = grp_engQ,
     tooltip = "A breakout candle with a long wick against its direction (share of the candle range above this) looks like a sweep/trap and is rejected.")

grp_engR = "Engine - Risk (locked R:R)"
i_engineRR = input.float(2.0, "Locked Reward:Risk", minval = 1.0, step = 0.5, group = grp_engR,
     tooltip = "With the Engine ON, TP is ALWAYS entry +/- risk x this value (2.0 = 1:2).")
i_maxRiskATR = input.float(3.0, "Skip trade if risk is wider than (x ATR)", minval = 0.5, step = 0.5, group = grp_engR,
     tooltip = "Keeps 1:2 realistic: if the structural stop is too far, the trade is skipped.")
i_minRiskATR = input.float(0.3, "Minimum risk (x ATR)", minval = 0.0, step = 0.1, group = grp_engR,
     tooltip = "If the structural stop is tighter than this it is widened to this distance, so noise doesn't stop the trade out.")
i_oneTrade = input.bool(true, "One trade at a time", group = grp_engR,
     tooltip = "New signals are blocked while the previous signal's TP/SL has not been hit.")

grp_engV = "Engine - Visuals"
i_showSweeps = input.bool(false, "Show sweep / real-break markers", group = grp_engV,
     tooltip = "Off by default so the chart looks exactly like the original indicator. Turn on to see sweeps, real breaks and structure shifts.")
i_showSwings = input.bool(false, "Show last swing high / low lines", group = grp_engV)
i_showStats = input.bool(false, "Show dashboard", group = grp_engV)

lblSize = i_labelSize == "Tiny" ? size.tiny : i_labelSize == "Normal" ? size.normal : size.small

// =============================================================================
// HEIKIN ASHI (manual calculation -- no request.security, no repainting)
// =============================================================================

var float haOpenState = na
haClose = (open + high + low + close) / 4.0
haOpenState := na(haOpenState[1]) ? (open + close) / 2.0 : (haOpenState[1] + haClose[1]) / 2.0
haOpen = haOpenState
haHigh = math.max(high, math.max(haOpen, haClose))
haLow  = math.min(low, math.min(haOpen, haClose))

plotcandle(i_plotHA ? haOpen : na, i_plotHA ? haHigh : na, i_plotHA ? haLow : na, i_plotHA ? haClose : na,
     title = "Heikin Ashi",
     color = haClose >= haOpen ? color.new(i_buyColor, 30) : color.new(i_sellColor, 30),
     wickcolor = color.gray, bordercolor = haClose >= haOpen ? i_buyColor : i_sellColor)

// Pattern-shape source: HA or real, per toggle. Used ONLY for candle-shape
// judgment (sideways character, engulfing, body size) -- never for price levels.
pO = i_useHA ? haOpen  : open
pC = i_useHA ? haClose : close

atrVal = ta.atr(i_atrLen)
ema50 = ta.ema(close, i_trendEmaLen)

// =============================================================================
// BREAKOUT CANDLE PATTERN
//
// Two independent ways for a candle to count as "decisive" -- an engulfing
// candle already proves strength by fully reversing the prior bar, so it
// doesn't need the body-size test too. This mirrors real chart reading: a
// valid breakout candle is either a clean engulf or simply oversized.
// =============================================================================

avgBody = math.sum(math.abs(pC[1] - pO[1]), i_avgBodyLen) / i_avgBodyLen
bodyCur = math.abs(pC - pO)

bullEngulf = pC > pO and pC[1] < pO[1] and pO <= pC[1] and pC >= pO[1]
bearEngulf = pC < pO and pC[1] > pO[1] and pO >= pC[1] and pC <= pO[1]

bigBodyUp = pC > pO and avgBody > 0 and bodyCur >= avgBody * i_bodyMult
bigBodyDown = pC < pO and avgBody > 0 and bodyCur >= avgBody * i_bodyMult

strongUp = bullEngulf or bigBodyUp
strongDown = bearEngulf or bigBodyDown

// =============================================================================
// CONGESTION ZONE DETECTION (fixed 30-bar window)
//
// Tests a single fixed-size window every bar for sideways/ranging shape.
// Runs independent of candle strength -- zone identity and breakout-candle
// quality are separate questions. Decisiveness (engulfing / big body) is
// applied only at breakout confirmation below, not here.
// =============================================================================

zoneHigh = ta.highest(high[1], i_zoneLen)
zoneLow = ta.lowest(low[1], i_zoneLen)
zoneRange = zoneHigh - zoneLow
netMove = math.abs(pC[1] - pC[i_zoneLen])
trendRatio = zoneRange > 0 ? netMove / zoneRange : 1.0
swingATR = atrVal > 0 ? zoneRange / atrVal : 0.0
zoneFound = trendRatio <= i_maxTrendRatio and swingATR <= i_maxSwingATR
zoneSize = i_zoneLen

rawBreakUp = zoneFound and strongUp and close > zoneHigh
rawBreakDown = zoneFound and strongDown and close < zoneLow

// =============================================================================
// DIGITAL / ROUND-NUMBER CONFLUENCE
// =============================================================================

nearestLevel = math.round(close / i_digitalStep) * i_digitalStep
distToLevel = math.abs(close - nearestLevel)
nearDigitalLevel = distToLevel <= (atrVal * i_digitalTolATR)
digitalOK = not i_requireDigital or nearDigitalLevel

// =============================================================================
// DUPLICATE-PHASE SUPPRESSION
//
// A new zone that substantially overlaps the last traded one in price is
// suppressed until EITHER price moves meaningfully (ATR-based) beyond it, OR
// enough bars pass -- whichever happens first. Prevents one continuous
// congestion-then-breakout move from firing multiple overlapping entries.
// =============================================================================

var int lastSignalBar = na
var float lastZoneHigh = na
var float lastZoneLow = na

barsSinceSignal = na(lastSignalBar) ? na : bar_index - lastSignalBar
cooldownCleared = na(lastSignalBar) or barsSinceSignal >= i_dedupCooldownBars
movedAway = na(lastZoneHigh) or na(lastZoneLow) or
     close > lastZoneHigh + atrVal * i_minMoveATR or
     close < lastZoneLow - atrVal * i_minMoveATR
isDistinctPhase = cooldownCleared and movedAway

// =============================================================================
// TRADE STATE (declared here so the engine can see whether a trade is open)
// =============================================================================

buffer = atrVal * i_slBufferATR

var float activeSL = na
var float activeTP = na
var string activeSide = na
var int entryBar = na
var int wins = 0
var int losses = 0
var string lastEvent = "-"

// =============================================================================
// LIQUIDITY SWEEP + TREND ENGINE
//
// 1) Swing highs/lows (tops and bottoms) -> market structure trend.
// 2) Liquidity pools = swing highs/lows and the edges of the congestion zone.
// 3) When price pushes past a pool:
//      - closes back inside quickly  -> SWEEP (false break, reversal setup)
//      - stays outside               -> REAL break (level retired, continuation)
// 4) A sweep is scored for quality, then only CONFIRMED by a structure shift
//    (close through the recent swing). Never an entry on the sweep candle.
// 5) Congestion breakouts must agree with the trend and not look like a trap.
// =============================================================================

// ---- candle anatomy (real price) ---------------------------------------------
rngCur = high - low
lowWick = math.min(open, close) - low
upWick = high - math.max(open, close)
bodyReal = math.abs(close - open)
volSma = ta.sma(volume, 20)
volSpike = volSma > 0 and math.max(volume, nz(volume[1])) >= i_volMult * volSma
dispUp = close > open and bodyReal >= i_dispATR * atrVal
dispDn = close < open and bodyReal >= i_dispATR * atrVal
emaSlow = ta.ema(close, i_trendSlowLen)

// ---- swing highs / lows (confirmed i_swingLen bars late, never repaint) --------
ph = ta.pivothigh(high, i_swingLen, i_swingLen)
pl = ta.pivotlow(low, i_swingLen, i_swingLen)

var float sh1 = na
var float sh2 = na
var float sl1 = na
var float sl2 = na

if not na(ph)
    sh2 := sh1
    sh1 := ph
if not na(pl)
    sl2 := sl1
    sl1 := pl

// HH+HL = UP, LH+LL = DOWN, otherwise RANGE
structTrend = (na(sh2) or na(sl2)) ? 0 : (sh1 > sh2 and sl1 > sl2) ? 1 : (sh1 < sh2 and sl1 < sl2) ? -1 : 0

rangeMid = zoneFound ? (zoneHigh + zoneLow) / 2 : (sh1 + sl1) / 2
eqBull = not na(sl1) and not na(sl2) and math.abs(sl1 - sl2) <= i_eqTolATR * atrVal
eqBear = not na(sh1) and not na(sh2) and math.abs(sh1 - sh2) <= i_eqTolATR * atrVal

// ---- breach tracker: sweep (price comes back) vs real break (price stays out) ---
trackSwing(float lvl, bool isLow, float atrV, int rBars, float minD, float maxD) =>
    var float ext = na
    var int bBar = na
    var bool dead = false
    var float lastLvl = na
    if na(lvl) or na(lastLvl) or lvl != lastLvl
        ext := na
        bBar := na
        dead := false
        lastLvl := lvl
    breach = not na(lvl) and not dead and (isLow ? low < lvl : high > lvl)
    if breach
        ext := na(ext) ? (isLow ? low : high) : (isLow ? math.min(ext, low) : math.max(ext, high))
        if na(bBar)
            bBar := bar_index
    reclaim = not na(bBar) and not dead and (isLow ? close > lvl : close < lvl) and bar_index - bBar <= rBars
    realBrk = not na(bBar) and not dead and not reclaim and bar_index - bBar >= rBars
    depth = isLow ? lvl - ext : ext - lvl
    sweep = reclaim and depth >= minD * atrV and depth <= maxD * atrV
    fast = bBar == bar_index
    outExt = ext
    if reclaim
        bBar := na
        ext := na
    if realBrk
        dead := true
        bBar := na
        ext := na
    [sweep, outExt, realBrk, fast]

[sweepLowSwing, sweepLowExt, realBreakDown, fastLow] = trackSwing(sl1, true, atrVal, i_reclaimBars, i_minDepthATR, i_maxDepthATR)
[sweepHighSwing, sweepHighExt, realBreakUp, fastHigh] = trackSwing(sh1, false, atrVal, i_reclaimBars, i_minDepthATR, i_maxDepthATR)

// Congestion-zone edges: single-candle sweep (wick through the edge, close back inside)
zoneSweepLow = zoneFound and low < zoneLow and close > zoneLow and (zoneLow - low) >= i_minDepthATR * atrVal and (zoneLow - low) <= i_maxDepthATR * atrVal
zoneSweepHigh = zoneFound and high > zoneHigh and close < zoneHigh and (high - zoneHigh) >= i_minDepthATR * atrVal and (high - zoneHigh) <= i_maxDepthATR * atrVal

bullSweepEv = i_useEngine and (sweepLowSwing or zoneSweepLow)
bearSweepEv = i_useEngine and (sweepHighSwing or zoneSweepHigh)
bullExt = sweepLowSwing ? math.min(sweepLowExt, low) : low
bearExt = sweepHighSwing ? math.max(sweepHighExt, high) : high
bullFast = zoneSweepLow or fastLow
bearFast = zoneSweepHigh or fastHigh

// ---- sweep quality score (0-6 here, +1 displacement at confirmation = 7) --------
bullQ = (bullFast ? 1 : 0) + ((rngCur > 0 and lowWick / rngCur >= i_wickPct) ? 1 : 0) + (volSpike ? 1 : 0) + (eqBull ? 1 : 0) + (close > emaSlow ? 1 : 0) + (close <= rangeMid ? 1 : 0)
bearQ = (bearFast ? 1 : 0) + ((rngCur > 0 and upWick / rngCur >= i_wickPct) ? 1 : 0) + (volSpike ? 1 : 0) + (eqBear ? 1 : 0) + (close < emaSlow ? 1 : 0) + (close >= rangeMid ? 1 : 0)

// structure-shift levels: recent minor high/low BEFORE this bar
recentHigh = ta.highest(high, i_chochLen)[1]
recentLow = ta.lowest(low, i_chochLen)[1]

// ---- armed state: wait for the structure shift ---------------------------------
var int bullBar = na
var float bullLow = na
var float bullStruct = na
var int bullScore = 0
var int bearBar = na
var float bearHigh = na
var float bearStruct = na
var int bearScore = 0

if bullSweepEv
    bullBar := bar_index
    bullLow := bullExt
    bullStruct := recentHigh
    bullScore := bullQ
    lastEvent := "Bull sweep (score " + str.tostring(bullQ) + ")"
if bearSweepEv
    bearBar := bar_index
    bearHigh := bearExt
    bearStruct := recentLow
    bearScore := bearQ
    lastEvent := "Bear sweep (score " + str.tostring(bearQ) + ")"
if i_useEngine and realBreakDown
    lastEvent := "REAL break DOWN"
if i_useEngine and realBreakUp
    lastEvent := "REAL break UP"

bullArmed = not na(bullBar) and bar_index - bullBar > 0 and bar_index - bullBar <= i_armBars and low >= bullLow
bearArmed = not na(bearBar) and bar_index - bearBar > 0 and bar_index - bearBar <= i_armBars and high <= bearHigh

// sweep extreme violated -> it was a real break after all
if not na(bullBar) and bar_index - bullBar > 0 and low < bullLow
    bullBar := na
    lastEvent := "Bull sweep FAILED"
if not na(bearBar) and bar_index - bearBar > 0 and high > bearHigh
    bearBar := na
    lastEvent := "Bear sweep FAILED"

bullStructBreak = bullArmed and close > bullStruct
bearStructBreak = bearArmed and close < bearStruct
bullTotal = bullScore + (dispUp ? 1 : 0)
bearTotal = bearScore + (dispDn ? 1 : 0)
bullConfirm = bullStructBreak and bullTotal >= i_minScore
bearConfirm = bearStructBreak and bearTotal >= i_minScore

if bullStructBreak
    if bullTotal < i_minScore
        lastEvent := "Bull setup skipped (score " + str.tostring(bullTotal) + ")"
    bullBar := na
if bearStructBreak
    if bearTotal < i_minScore
        lastEvent := "Bear setup skipped (score " + str.tostring(bearTotal) + ")"
    bearBar := na

// ---- trend gate: structure trend decides which side is allowed -----------------
longGate = not i_trendGate or structTrend == 1 or (i_allowRange and structTrend == 0)
shortGate = not i_trendGate or structTrend == -1 or (i_allowRange and structTrend == 0)

// ---- breakout quality: aligned with trend, no rejection wick, no opposite sweep armed
brkGateUp = longGate and (rngCur > 0 and upWick / rngCur <= i_maxBrkWick) and not bearArmed
brkGateDown = shortGate and (rngCur > 0 and lowWick / rngCur <= i_maxBrkWick) and not bullArmed

// =============================================================================
// SIGNAL CONFIRMATION
// =============================================================================

origBuy = rawBreakUp and digitalOK and isDistinctPhase
origSell = rawBreakDown and digitalOK and isDistinctPhase

brkBuyCand = i_useEngine ? (origBuy and brkGateUp) : origBuy
brkSellCand = i_useEngine ? (origSell and brkGateDown) : origSell
swpBuyCand = i_useEngine and bullConfirm and longGate
swpSellCand = i_useEngine and bearConfirm and shortGate

// structural stop for the engine: beyond the sweep extreme, or beyond the breakout
// candle / zone edge for a breakout
buyStopRaw = swpBuyCand ? bullLow - buffer : math.min(low, zoneHigh) - buffer
sellStopRaw = swpSellCand ? bearHigh + buffer : math.max(high, zoneLow) + buffer
buyRiskOK = not i_useEngine or (close - buyStopRaw > 0 and close - buyStopRaw <= i_maxRiskATR * atrVal)
sellRiskOK = not i_useEngine or (sellStopRaw - close > 0 and sellStopRaw - close <= i_maxRiskATR * atrVal)

anyBuy = (brkBuyCand or swpBuyCand) and buyRiskOK
anySell = (brkSellCand or swpSellCand) and sellRiskOK
tradeBlocked = i_useEngine and i_oneTrade and not na(activeSide)

buySignal = anyBuy and not anySell and not tradeBlocked
sellSignal = anySell and not anyBuy and not tradeBlocked

buyIsSweep = buySignal and swpBuyCand
sellIsSweep = sellSignal and swpSellCand

buyCounterTrend = buySignal and close < ema50
sellCounterTrend = sellSignal and close > ema50

if buySignal or sellSignal
    lastSignalBar := bar_index
    lastZoneHigh := zoneHigh
    lastZoneLow := zoneLow
if (buySignal and not buyIsSweep) or (sellSignal and not sellIsSweep)
    box.new(bar_index - zoneSize, zoneHigh, bar_index - 1, zoneLow,
         border_color = i_boxBorder, bgcolor = i_boxFill, border_width = 1)

if buySignal
    lastEvent := buyIsSweep ? "BUY sweep+shift (score " + str.tostring(bullTotal) + ")" : "BUY zone breakout"
if sellSignal
    lastEvent := sellIsSweep ? "SELL sweep+shift (score " + str.tostring(bearTotal) + ")" : "SELL zone breakout"

// =============================================================================
// RISK LEVELS
//
// Engine OFF: SL sits beyond the zone's own extreme (zone range x multiplier)
// plus a small ATR buffer; TP per the chosen method (original behavior).
// Engine ON: SL is structural (beyond the sweep extreme, or beyond the breakout
// candle / zone edge), and TP is ALWAYS entry +/- risk x the locked R:R (1:2).
// =============================================================================

nextRoundAbove(p) =>
    lvl = math.ceil(p / i_digitalStep) * i_digitalStep
    lvl - p < i_digitalStep * 0.2 ? lvl + i_digitalStep : lvl

nextRoundBelow(p) =>
    lvl = math.floor(p / i_digitalStep) * i_digitalStep
    p - lvl < i_digitalStep * 0.2 ? lvl - i_digitalStep : lvl

if buySignal
    slDist = i_useEngine ? math.max(close - buyStopRaw, atrVal * i_minRiskATR) : (zoneHigh - zoneLow) * i_slRangeMult + buffer
    sl = close - slDist
    tp = i_useEngine ? close + slDist * i_engineRR : (i_tpMethod == "Fixed R:R" ? close + slDist * i_fixedRR : nextRoundAbove(close))
    activeSL := sl
    activeTP := tp
    activeSide := "long"
    entryBar := bar_index

if sellSignal
    slDist = i_useEngine ? math.max(sellStopRaw - close, atrVal * i_minRiskATR) : (zoneHigh - zoneLow) * i_slRangeMult + buffer
    sl = close + slDist
    tp = i_useEngine ? close - slDist * i_engineRR : (i_tpMethod == "Fixed R:R" ? close - slDist * i_fixedRR : nextRoundBelow(close))
    activeSL := sl
    activeTP := tp
    activeSide := "short"
    entryBar := bar_index

// =============================================================================
// VISUALS -- entry marker, SL/TP labels and lines, R:R label
// =============================================================================

plotshape(buySignal, title = "Buy Signal", style = shape.triangleup, location = location.belowbar,
     color = i_buyColor, size = size.small)
plotshape(sellSignal, title = "Sell Signal", style = shape.triangledown, location = location.abovebar,
     color = i_sellColor, size = size.small)

if buySignal and i_showDigital and nearDigitalLevel
    label.new(bar_index, low, "◆", style = label.style_none, textcolor = color.yellow, size = size.small)
if sellSignal and i_showDigital and nearDigitalLevel
    label.new(bar_index, high, "◆", style = label.style_none, textcolor = color.yellow, size = size.small)

drawTradeVisuals(isBuy, entryPrice, sl, tp, ctFlag, tagTxt) =>
    lineColor = isBuy ? i_buyColor : i_sellColor
    line.new(bar_index, entryPrice, bar_index + 15, entryPrice, color = color.new(color.gray, 50), style = line.style_dotted)
    line.new(bar_index, tp, bar_index + 15, tp, color = color.new(color.teal, 20), style = line.style_dashed)
    line.new(bar_index, sl, bar_index + 15, sl, color = color.new(color.red, 20), style = line.style_dashed)
    label.new(bar_index + 15, tp, "TP  " + str.tostring(tp, format.mintick),
         style = label.style_label_left, color = color.new(color.teal, 20), textcolor = color.white, size = lblSize)
    label.new(bar_index + 15, sl, "SL  " + str.tostring(sl, format.mintick),
         style = label.style_label_left, color = color.new(color.red, 20), textcolor = color.white, size = lblSize)
    label.new(bar_index, isBuy ? low - atrVal * 0.5 : high + atrVal * 0.5,
         (isBuy ? "BUY  " : "SELL  ") + str.tostring(entryPrice, format.mintick) + (ctFlag ? "  ⚠ CT" : "") + tagTxt,
         style = isBuy ? label.style_label_up : label.style_label_down,
         color = lineColor, textcolor = color.white, size = lblSize)
    if i_showRR and math.abs(entryPrice - sl) > 0
        rr = math.abs(tp - entryPrice) / math.abs(entryPrice - sl)
        label.new(bar_index, isBuy ? low - atrVal * 1.3 : high + atrVal * 1.3,
             "R:R 1:" + str.tostring(rr, "#.##"),
             style = label.style_none, textcolor = color.gray, size = size.tiny)

buyTag = buyIsSweep ? "  SWEEP S" + str.tostring(bullTotal) : ""
sellTag = sellIsSweep ? "  SWEEP S" + str.tostring(bearTotal) : ""

if buySignal
    drawTradeVisuals(true, close, activeSL, activeTP, buyCounterTrend, buyTag)
if sellSignal
    drawTradeVisuals(false, close, activeSL, activeTP, sellCounterTrend, sellTag)

// ---- engine markers, swing levels, dashboard -----------------------------------

plotshape(i_showSweeps and bullSweepEv, title = "Bull sweep (sell-side liquidity taken)", style = shape.diamond, location = location.belowbar,
     color = color.new(color.lime, 20), size = size.tiny)
plotshape(i_showSweeps and bearSweepEv, title = "Bear sweep (buy-side liquidity taken)", style = shape.diamond, location = location.abovebar,
     color = color.new(color.orange, 20), size = size.tiny)
plotshape(i_showSweeps and i_useEngine and realBreakDown, title = "Real break DOWN", style = shape.xcross, location = location.abovebar,
     color = color.new(color.red, 0), size = size.tiny)
plotshape(i_showSweeps and i_useEngine and realBreakUp, title = "Real break UP", style = shape.xcross, location = location.belowbar,
     color = color.new(color.green, 0), size = size.tiny)
plotshape(i_showSweeps and bullStructBreak, title = "Bull structure shift", style = shape.circle, location = location.belowbar,
     color = color.new(color.teal, 0), size = size.tiny)
plotshape(i_showSweeps and bearStructBreak, title = "Bear structure shift", style = shape.circle, location = location.abovebar,
     color = color.new(color.maroon, 0), size = size.tiny)

plot(i_showSwings ? sh1 : na, title = "Last swing high (buy-side liquidity)", color = color.new(color.red, 40), style = plot.style_linebr)
plot(i_showSwings ? sl1 : na, title = "Last swing low (sell-side liquidity)", color = color.new(color.green, 40), style = plot.style_linebr)

var table dash = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 50))

if barstate.islast and i_showStats
    trTxt = structTrend == 1 ? "UP (HH/HL)" : structTrend == -1 ? "DOWN (LH/LL)" : "RANGE"
    trCol = structTrend == 1 ? color.green : structTrend == -1 ? color.red : color.gray
    biasTxt = close > emaSlow ? "Above slow EMA" : "Below slow EMA"
    armTxt = bullArmed ? "Bull sweep armed (S" + str.tostring(bullScore) + ")" : bearArmed ? "Bear sweep armed (S" + str.tostring(bearScore) + ")" : "None"
    totalTr = wins + losses
    wrTxt = totalTr > 0 ? str.tostring(wins / totalTr * 100, "#.#") + "%" : "-"
    table.cell(dash, 0, 0, "Structure", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, i_useEngine ? trTxt : "Engine OFF", text_color = trCol, text_size = size.small)
    table.cell(dash, 0, 1, "Bias", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 1, biasTxt, text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 2, "Armed sweep", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 2, armTxt, text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 3, "Last event", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 3, lastEvent, text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 4, "Wins / Losses", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(wins) + " / " + str.tostring(losses), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 5, "Win rate", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 5, wrTxt, text_color = color.white, text_size = size.small)

// =============================================================================
// WEBHOOK ALERTS (dynamic -- for the MT5 bridge)
//
// Message format must match the bridge server's parseSignal() regex exactly:
//   "(BUY|SELL) Signal - X, Close: N, TP: N, SL: N, Time: T"
// Requires a single alert created on this script with condition "Any alert()
// function call", webhook URL pointed at the bridge (POST /webhook).
// =============================================================================

if buySignal
    alert("BUY Signal - Hamoody v4, Close: " + str.tostring(close, format.mintick) +
         ", TP: " + str.tostring(activeTP, format.mintick) +
         ", SL: " + str.tostring(activeSL, format.mintick) +
         ", Time: " + str.format_time(time, "yyyy-MM-dd HH:mm"), alert.freq_once_per_bar_close)
if sellSignal
    alert("SELL Signal - Hamoody v4, Close: " + str.tostring(close, format.mintick) +
         ", TP: " + str.tostring(activeTP, format.mintick) +
         ", SL: " + str.tostring(activeSL, format.mintick) +
         ", Time: " + str.format_time(time, "yyyy-MM-dd HH:mm"), alert.freq_once_per_bar_close)

// =============================================================================
// TP / SL HIT TRACKING (for alerting -- this is an indicator, not a strategy,
// so hits are simulated by watching price cross the stored levels)
//
// The entry bar itself is never checked (entry happens at its close). If TP and
// SL are both touched inside the same candle the order is unknown, so it is
// counted as a stop-out (conservative).
// =============================================================================

canCheck = not na(entryBar) and bar_index > entryBar

tpHitLong = canCheck and activeSide == "long" and not na(activeTP) and high >= activeTP
slHitLong = canCheck and activeSide == "long" and not na(activeSL) and low <= activeSL
tpHitShort = canCheck and activeSide == "short" and not na(activeTP) and low <= activeTP
slHitShort = canCheck and activeSide == "short" and not na(activeSL) and high >= activeSL

slHit = slHitLong or slHitShort
tpHit = (tpHitLong or tpHitShort) and not slHit

if tpHit
    wins += 1
if slHit
    losses += 1

if tpHit or slHit
    activeSide := na
    activeSL := na
    activeTP := na

// =============================================================================
// ALERTS
// =============================================================================

alertcondition(buySignal, title = "Buy Signal", message = "Congestion Breakout Pro: BUY signal on {{ticker}} at {{close}}")
alertcondition(sellSignal, title = "Sell Signal", message = "Congestion Breakout Pro: SELL signal on {{ticker}} at {{close}}")
alertcondition(tpHit, title = "Take Profit Hit", message = "Congestion Breakout Pro: TP hit on {{ticker}}")
alertcondition(slHit, title = "Stop Loss Hit", message = "Congestion Breakout Pro: SL hit on {{ticker}}")
alertcondition(bullSweepEv or bearSweepEv, title = "Liquidity Sweep", message = "Congestion Breakout Pro: liquidity sweep on {{ticker}}")
